{
  "name": "content-os",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
    ,"test:video-render-worker:integration": "node scripts/video-render-worker.integration.mjs",
    "test:api-bootstrap:smoke": "turbo run build --filter=api... && node scripts/api-bootstrap-smoke.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2",
    "wrangler": "^4.120.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=18"
  }
}
